---
// Step 4 of the route (the first about the participant's own work): before learning HOW to use AI well, participants
// find out WHAT they could use it for, and what their AI can do. Written for
// people who want to do something with AI at work but do not know where to
// start. We do not tell participants which step of the context ladder they are
// on: the site cannot know that. Nothing here uses Vezelvriend data.
// What participants write and paste here is saved under their code, so the
// trainer can read it (components/Aantekening.astro).
import Base from '../../../layouts/TrainingLayout.astro';
import Vlak from '../../../components/Vlak.astro';
import Aantekening from '../../../components/Aantekening.astro';
import Volgende from '../../../components/Volgende.astro';
import { headLine } from '../../../route';
import { LONG, SHORT } from '../../../intake';

const firstTask = [
  { number: 1, title: 'Je doet hem vaak', text: 'Minstens elke week. Dan levert het iets op, en oefen je vanzelf.' },
  { number: 2, title: 'Het is werk met tekst', text: 'Geen beslissing. De AI maakt een eerste versie, jij beslist.' },
  { number: 3, title: 'Je kunt het nakijken', text: 'Je weet genoeg van het onderwerp om een fout te zien.' },
  { number: 4, title: 'Er zit niets in dat niet mag', text: 'Geen persoonsgegevens of vertrouwelijke stukken, tenzij je werkgever dat uitdrukkelijk toestaat.' },
];

const tasks = [
  { label: 'Mail en berichten', title: 'Lezen en schrijven', text: 'Een lange mailwisseling samenvatten tot de afspraken. Een lastige mail herschrijven: korter, vriendelijker of duidelijker. Een eerste versie van een antwoord maken.' },
  { label: 'Overleg', title: 'Voorbereiden en vastleggen', text: 'Een agenda opstellen. Aantekeningen omzetten in besluiten en actiepunten met een eigenaar. Vragen bedenken die je in een overleg wilt stellen.' },
  { label: 'Documenten', title: 'Bronnen doorzoeken', text: 'Uit een beleidsstuk of handleiding halen wat voor jouw vraag geldt, met de paragraaf erbij. Twee versies van een document vergelijken.' },
  { label: 'Analisten', title: 'Eisen en user stories', text: 'Eisen uit mails en verslagen halen. Een user story met acceptatiecriteria opzetten. Gaten en tegenstrijdigheden zoeken in wat er al ligt.' },
  { label: 'Testers', title: 'Testgevallen en randgevallen', text: 'Testgevallen afleiden uit een beschrijving of regel. Randgevallen bedenken. Een bevinding helder opschrijven: verwacht, werkelijk, stappen.' },
  { label: 'Uitleggen', title: 'Begrijpelijk maken', text: 'Een technisch stuk uitleggen in gewone taal. Een tekst schrijven voor een andere doelgroep. Een SQL-vraag of foutmelding laten uitleggen.' },
  { label: 'Meedenken', title: 'Advocaat van de duivel', text: 'Je plan of ontwerp laten bekritiseren: wat zie ik over het hoofd? Welke vragen gaat de stuurgroep stellen? Wat zijn de zwakke plekken?' },
  { label: 'Ordenen', title: 'Structuur aanbrengen', text: "Honderden klantreacties in thema's verdelen. Rommelige aantekeningen omzetten in een tabel. Een lange lijst groeperen en ontdubbelen." },
  { label: 'Leren', title: 'Jezelf iets eigen maken', text: 'Een nieuw begrip of vakgebied laten uitleggen, met voorbeelden. Jezelf laten overhoren. Een Excel-formule stap voor stap laten uitleggen.' },
];

// Traffic light, as in step 7. Orange: where AI is weak depends on what it
// has to work with; the same task can go well with the right context or tool,
// and wrong without. Sources (22-10-2026): BCG/Harvard "jagged frontier" field
// experiment, Autoriteit Persoonsgegevens on data leaks via AI chatbots, EU AI
// Act (decisions about employees are high-risk).
const orange = [
  { label: 'Feiten en bronnen', title: 'Uit je bronnen, niet uit zijn hoofd', text: 'Goed als je de documenten meegeeft en hij bij elk antwoord de bron noemt. Riskant als hij het uit zijn geheugen haalt: dan verzint hij soms een wetsartikel, citaat of link die niet bestaat.' },
  { label: 'Rekenen en tellen', title: 'Met een rekenhulpmiddel', text: 'Goed als hij rekent met code of Excel en je ziet hoe. Riskant als hij uit het hoofd rekent of telt in een lang antwoord: rijen tellen, totalen, percentages halverwege een tekst.' },
  { label: 'Wat bij jullie geldt', title: 'Hij kent jullie niet', text: 'Goed als je de regels, de werkwijze en de laatste stand meegeeft. Riskant als hij moet raden hoe jullie werken of wat de laatste stand is.' },
  { label: 'Lange stukken', title: 'Vraag gericht', text: 'Goed als je vraagt naar een bepaald onderdeel, met de vindplaats erbij. Riskant als hij alles in één keer moet samenvatten: dan mist hij dingen, vaak in het midden.' },
  { label: 'Controleren', title: 'Jij kijkt na, niet hij', text: 'Goed als jij het nakijkt in de bron. Riskant als je vraagt "weet je het zeker?": dan krijg je vaak alleen een andere toon, geen controle.' },
  { label: 'Het lastige', title: 'Je ziet het niet altijd', text: 'Een fout antwoord klinkt net zo zeker als een goed antwoord. Daarom kijk je bij oranje altijd na.' },
];
const red = [
  { label: 'Over mensen', title: 'Beslissen over mensen', text: 'Selectie, beoordeling of ontslag laat je niet aan AI over. De Europese AI-wet noemt dat hoog risico.' },
  { label: 'Gegevens', title: 'Persoonsgegevens zonder afspraak', text: 'Geen persoonsgegevens of vertrouwelijke stukken, tenzij je werkgever dat heeft afgesproken. De Autoriteit Persoonsgegevens krijgt steeds meer meldingen van datalekken op deze manier.' },
  { label: 'Acties', title: 'Zelf versturen of uitvoeren', text: 'Geen mail aan een klant, betaling of opdracht zonder dat iemand meekijkt.' },
  { label: 'Advies', title: 'Het laatste woord', text: 'Bij juridisch, medisch of financieel advies beslist een deskundige, niet de AI.' },
  { label: 'Gesprekken', title: 'Een mens nodig', text: 'Slecht nieuws of een conflict breng je zelf. Helpen voorbereiden mag wel.' },
  { label: 'Controle', title: 'Werk dat je niet kunt nakijken', text: 'Kun jij de uitkomst niet beoordelen? Dan weet je ook niet of hij klopt.' },
];
---
<Base title="Wat kan AI voor jou?" description="Ontdek welke taken in je werk geschikt zijn voor AI, en welke AI jij mag gebruiken.">
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">{headLine(4)}</p>
      <h1>Wat kan AI voor jou?</h1>
      <p class="lead">Voordat je leert hoe je AI goed gebruikt, kijk je eerst waarvoor. Welke taken in jouw werk lenen zich ervoor, en welke AI mag jij gebruiken? Met die twee antwoorden maak je de rest van de oefeningen, en aan het eind doe je een echte taak van jezelf.</p>
    </div>
  </section>

  <section class="sectie">
    <div class="wrap">
      <h2><span class="kop-toon kop-toon--groen" aria-hidden="true"></span>Groen licht</h2>
      <p class="prose">Hier is AI sterk in: werk met tekst, zoals lezen, samenvatten, ordenen, herschrijven en ideeën bedenken. Streep in gedachten aan wat je vaak doet.</p>
      <Vlak columns={3} items={tasks} tone="groen" />
    </div>
  </section>

  <section class="sectie sectie--vlak">
    <div class="wrap">
      <h2><span class="kop-toon kop-toon--oranje" aria-hidden="true"></span>Oranje: kijk uit</h2>
      <p class="prose">Hier kan het goed gaan of mis. Dat hangt af van wat je meegeeft en welke hulpmiddelen de AI heeft.</p>
      <Vlak columns={3} items={orange} tone="oranje" />
    </div>
  </section>

  <section class="sectie">
    <div class="wrap">
      <h2><span class="kop-toon kop-toon--rood" aria-hidden="true"></span>Rood: hier niet aan beginnen</h2>
      <p class="prose">Dit laat je niet aan AI over, hoe goed het antwoord ook klinkt.</p>
      <Vlak columns={3} items={red} tone="rood" />
    </div>
  </section>

  <section class="sectie sectie--vlak">
    <div class="wrap">
      <h2>Zo kies je je eerste taak</h2>
      <p class="prose">Een goede eerste taak voldoet aan vier dingen:</p>
      <Vlak columns={4} items={firstTask} />

      <h3 class="tussenkop">Probeer het meteen, één keer kaal</h3>
      <div class="prose">
        <p>Stel je AI de vraag voor je taak zoals je hem nu zou stellen, zonder voorbereiding. Schrijf hieronder op welke prompt je gebruikte, en plak het antwoord van je AI eronder.</p>
        <p class="let-op"><strong>Let op:</strong> zet hier geen bedrijfsgevoelige gegevens in, zoals namen van klanten of collega's, cijfers of vertrouwelijke stukken. Haal ze eerst weg of vervang ze. Wat je hier invult, wordt bewaard en de trainer kan het lezen.</p>
        <Aantekening page="wat-kan-ai" field="poging-prompt" label="1. Je prompt: wat vroeg je aan de AI?" rows={4} placeholder="Typ of plak hier je prompt" />
        <Aantekening page="wat-kan-ai" field="poging-antwoord" label="2. Het antwoord van de AI" rows={8} placeholder="Plak hier het antwoord" />
        <Aantekening page="wat-kan-ai" field="poging-cijfer" label="3. Hoe bruikbaar is dit, van 1 tot 10? En waarom?" rows={2} />
      </div>
    </div>
  </section>

  <section class="sectie">
    <div class="wrap">
      <h2>Welke AI heb jij, en wat kan die?</h2>
      <div class="prose">
        <p>Plak deze vragen in de AI die je op je werk gebruikt. Er zijn twee versies. <strong>Kort:</strong> vijf vragen, de AI vertelt wat hij kan. <strong>Lang:</strong> de AI test het echt, punt voor punt, en zet de uitkomst in een tabel. Dat duurt langer, maar dan weet je het zekerder.</p>
      </div>
      <div class="wissel" role="group" aria-label="Kies de korte of de lange versie" hidden>
        <button type="button" data-deel="kort" aria-pressed="true">Kort</button>
        <button type="button" data-deel="lang" aria-pressed="false">Lang</button>
      </div>
      <div class="wissel-deel prose" data-deel="kort">
        <h3>Kort: vijf vragen</h3>
        <pre class="prompt-alleen-kopieren"><code class="language-prompt">{SHORT}</code></pre>
        <Aantekening page="wat-kan-ai" field="ai-kort" label="Plak hier het antwoord van je AI op de korte vragen" rows={8} />
      </div>
      <div class="wissel-deel prose" data-deel="lang">
        <h3>Lang: laat de AI het testen</h3>
        <pre class="prompt-alleen-kopieren"><code class="language-prompt">{LONG}</code></pre>
        <Aantekening page="wat-kan-ai" field="ai-lang" label="Plak hier de tabel die je AI maakte" rows={10} />
      </div>
      <div class="prose">
        <p class="let-op"><strong>Let op:</strong> plak alleen wat de trainer mag zien. Staan er namen van mappen, systemen of collega's in het antwoord, haal die dan eerst weg.</p>
        <p>De antwoorden vertellen je welke manieren om context te geven jouw AI kent. Wat dat betekent, zie je in de volgende stappen. Koppelingen met andere systemen en agents stellen beheerders in; of die er zijn, weet je IT-afdeling het best.</p>
        <p>Zegt je AI dat hij dingen over jou onthoudt (geheugen)? Dan gaat wat hij onthoudt ongezien mee in elk gesprek. Dat is ook context. Kijk in de instellingen wat hij onthoudt, en haal weg wat er niet hoort.</p>
        <p>Mag je de AI van je werk niet gebruiken voor deze training? Gebruik dan de chat met Claude die naast de oefeningen staat. Daar gaat alleen verzonnen data in.</p>
      </div>
      <Volgende nr={4} />
    </div>
  </section>
  <script is:inline src="/assets/prompt.js" defer></script>
  <script is:inline src="/assets/wissel.js" defer></script>
  <script is:inline src="/assets/aantekening.js" defer></script>
</Base>
