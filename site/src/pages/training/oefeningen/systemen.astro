---
// Step 3: getting to know the systems, right before the exercises. Every
// participant has a customer of their own (/assets/mijnklant.js) and looks it
// up in each system: open it in a new tab, find one thing, tick it off. After
// this the exercises link straight to the systems. The list: src/systems.ts.
import Base from '../../../layouts/TrainingLayout.astro';
import Volgende from '../../../components/Volgende.astro';
import Rondleiding from '../../../components/Rondleiding.astro';
import { tour } from '../../../systems';
import { headLine } from '../../../route';

const items = tour.map((s) => ({
  ...s,
  href: s.key === 'beslisboom' ? '/training/oefeningen/documenten/beslisboom/' : `/${s.key === 'klantsysteem' ? 'klantsysteem' : 'klantbeeld'}/?systeem=${s.key}`,
  open: `Open ${s.name.split(':')[0]}`,
}));
---
<Base title="De systemen van Vezelvriend" description="Kennismaken met de systemen van het oefenbedrijf, met je eigen klant.">
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">{headLine(3)}</p>
      <h1>De systemen van Vezelvriend</h1>
      <p class="lead">In de oefeningen haal je gegevens uit de systemen van Vezelvriend. Ze zijn nagebouwd voor de training: eenvoudig, maar met de rommel van echte bedrijfssoftware. Je maakt er kennis mee met een klant die voor jou is gekozen. Open elk systeem, zoek één ding op, en vink het af.</p>
    </div>
  </section>

  <section class="sectie">
    <div class="wrap smal">
      <div class="mijn-klant"></div>
      <Rondleiding items={items} store="systemen" noun="systemen" />

      <div class="trap-let-op prose">
        <p><strong>Kan de AI in deze systemen kijken?</strong> Meestal niet. Je eigen AI kan de gegevens niet zelf ophalen: jij kiest wat je overneemt in je prompt, en jij ziet of een meting oud is of dat er een storing in de straat is. Er is één uitzondering: de chat met Claude <strong>met koppeling</strong> in stap 9. Daar zoekt Claude zelf, met volledige toegang.</p>
        <p>Klantgegevens, metingen, historie: alles wat je hier ziet is ook context. Denk bij elk systeem al na: wat hiervan zou jij aan een AI geven, en wat niet?</p>
      </div>
      <Volgende nr={3} />
    </div>
  </section>
  <script is:inline src="/assets/mijnklant.js" defer></script>
  <script is:inline src="/assets/tour.js" defer></script>
</Base>
