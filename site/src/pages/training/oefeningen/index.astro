---
import Base from '../../../layouts/TrainingLayout.astro';
import Vlak from '../../../components/Vlak.astro';
import { getExercises } from '../../../exercises';
const exercises = getExercises();
---
<Base title="Oefeningen">
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Oefeningen</p>
      <h1>Oefenen met context, grenzen en data</h1>
      <p class="lead">Elke oefening heeft een doel, een opdracht, een voorbeeldprompt zonder en met context, en een reflectievraag. Antwoorden staan er bewust niet bij: die bespreek je met de trainer.</p>
    </div>
  </section>
  <section class="sectie">
    <div class="wrap">
      {exercises.length === 0 && <p>De oefeningen komen binnenkort.</p>}
      <Vlak items={exercises.map((ex) => ({
        label: `Oefening ${ex.number} · ${ex.role}`,
        title: ex.title,
        text: ex.summary,
        href: `/training/oefeningen/${ex.slug}/`,
        linkLabel: 'Naar de oefening',
      }))} />
    </div>
  </section>
</Base>
