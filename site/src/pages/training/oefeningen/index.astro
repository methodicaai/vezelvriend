---
import Base from '../../../layouts/TrainingLayout.astro';
import Pad from '../../../components/Pad.astro';
import { getExercises } from '../../../exercises';
const exercises = getExercises();
const byNumber = (n: number) => exercises.find((ex) => ex.number === n);
const link = (n: number, label: string) => ({ href: `/training/oefeningen/${byNumber(n)?.slug}/`, label });
const exHref = (n: number) => `/training/oefeningen/${byNumber(n)?.slug}/`;

// The route: first what AI can do for you, then the context ladder from step 0
// to 4 (exercises 1 to 4 and the documents), the test, depth per role, and the
// participant's own work last. Times are rough, for planning and self-study.
const route = [
  { label: 'Begin hier · 20 min', title: 'Wat kan AI voor jou?', text: 'Kies een taak uit je eigen werk en zoek uit welke AI je hebt.', href: '/training/oefeningen/wat-kan-ai/', linkLabel: 'Naar stap 1' },
  { label: 'Uitleg · 10 min', title: 'De contexttrap', text: 'Vijf manieren waarop context bij een AI komt. Lees nu trede 0 en 1.', href: '/training/oefeningen/contexttrap/', linkLabel: 'Naar de contexttrap' },
  { label: 'Trede 0 en 1 · 30 min', title: byNumber(1)?.title ?? 'Context maakt het verschil', text: 'Dezelfde klantvraag, eerst kaal en daarna met gegevens die je zelf kiest.', href: exHref(1), linkLabel: 'Naar oefening 1' },
  { label: 'Trede 1 · 30 min', title: byNumber(2)?.title ?? 'Wat mag er naar de AI?', text: 'Vijftig notities van de servicedesk. Wat geef je aan de AI, en wat niet?', href: exHref(2), linkLabel: 'Naar oefening 2' },
  { label: 'Trede 2 · 25 min', title: 'Jij kiest de documenten', text: 'Zet de documenten van Vezelvriend in je AI en vraag ernaar. Kloppen je bronnen?', href: '/training/oefeningen/documenten/', linkLabel: 'Naar de documenten' },
  { label: 'Trede 3 en 4 · 25 min', title: byNumber(3)?.title ?? 'Claude zoekt zelf', text: 'Claude haalt alles zelf op en wil een monteur aanvragen. Wat komt er ongevraagd mee?', href: exHref(3), linkLabel: 'Naar oefening 3' },
  { label: 'Trede 4 · 30 min', title: byNumber(4)?.title ?? 'Guardrails schrijven', text: 'Schrijf regels voor wat de AI wel en niet mag, en probeer ze te breken.', href: exHref(4), linkLabel: 'Naar oefening 4' },
  { label: 'Proef · 20 min', title: 'Vind de fout', text: 'Acht AI-antwoorden. Eerst schatten hoe zeker je bent, dan controleren in de bron.', href: '/training/oefeningen/vind-de-fout/', linkLabel: 'Naar de proef' },
  { label: 'Naar je rol · 45 min per oefening', title: 'Verdiepen in je eigen vak', text: 'Analisten maken een user story, testers testcases. SQL en de code zijn voor allebei.', links: [link(5, 'Oefening 5: analist'), link(6, 'Oefening 6: tester'), link(7, 'Oefening 7: SQL'), { href: '/training/oefeningen/code/', label: 'De code' }] },
  { label: 'Eigen werk · 35 min', title: 'Werkbladen', text: 'Je eigen taak uit stap 1 in je eigen AI, en je als-dan-kaart om mee af te sluiten.', href: '/training/oefeningen/werkbladen/', linkLabel: 'Naar de werkbladen' },
];
---
<Base title="Oefeningen">
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Oefeningen</p>
      <h1>Oefenen met context, grenzen en data</h1>
      <p class="lead">Volg de route van boven naar beneden, of doe wat de trainer aangeeft. Antwoorden staan er bewust niet bij: die bespreek je met de trainer. Naast elke oefening staat een chat met Claude; je kunt hem ook <a href="/training/oefeningen/claude/">los openen</a>.</p>
    </div>
  </section>
  <section class="sectie">
    <div class="wrap">
      <h2>De route</h2>
      <Pad steps={route} />
    </div>
  </section>
  <script is:inline src="/assets/pad.js" defer></script>
</Base>
