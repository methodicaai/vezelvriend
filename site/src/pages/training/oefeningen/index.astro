---
import Base from '../../../layouts/TrainingLayout.astro';
import Pad from '../../../components/Pad.astro';
import { route } from '../../../route';

// The route: ten steps (src/route.ts). Every page on it is called "Stap N" with
// the same number as its stone, so participants never translate between two
// numberings. Times are rough, for planning and self-study. core = the short route.
const short = (time: string) => time.replace('minuten', 'min');
const pad = route.map((s) => ({
  nr: String(s.nr),
  label: `${s.trede ? `Trede ${s.trede.join(' en ')}` : s.kind} · ${short(s.time)}`,
  title: s.title, text: s.text, href: s.href, linkLabel: `Naar stap ${s.nr}`, links: s.links, core: s.core,
}));
const coreSteps = route.filter((s) => s.core).map((s) => s.nr);
---
<Base title="Oefeningen">
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">De route</p>
      <h1>Oefenen met context, grenzen en data</h1>
      <p class="lead">Volg de stappen van boven naar beneden, of doe wat de trainer aangeeft. Antwoorden staan er bewust niet bij: die bespreek je met de trainer. Naast elke stap staat een chat met Claude; je kunt hem ook <a href="/training/oefeningen/claude/">los openen</a>.</p>
    </div>
  </section>
  <section class="sectie">
    <div class="wrap">
      <div class="route-kop">
        <h2>De route</h2>
        <div class="route-lengte" role="group" aria-label="Lengte van de route" hidden>
          <button type="button" data-lengte="kort" aria-pressed="false">Kort <span>± 2 uur</span></button>
          <button type="button" data-lengte="alles" aria-pressed="true">Alles <span>± 5 uur</span></button>
        </div>
      </div>
      <p class="route-uitleg" data-voor="alles">Alle twaalf stappen. Heb je weinig tijd? Kies <strong>Kort</strong>: dan zie je alleen de stappen met <span class="pad-kern">kern</span>.</p>
      <p class="route-uitleg" data-voor="kort" hidden>De korte route: stap {coreSteps.slice(0, -1).join(', ')} en {coreSteps.at(-1)}. Eerst wat AI voor jou kan en de contexttrap, dan de oefening met je eigen klant, en tot slot je eigen taak. De andere stappen kun je later doen.</p>
      <Pad steps={pad} />
    </div>
  </section>
  <script is:inline src="/assets/pad.js" defer></script>
</Base>
