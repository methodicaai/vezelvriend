---
// One exercise, with the chat next to it so participants do not have to switch
// screens. The chat is fixed per exercise: without connection (the participant
// chooses the context, as in most exercises) or with connection (frontmatter
// "koppeling: aan", where Claude looks things up itself).
// Frontmatter "trede" puts the explanation of those ladder steps above the
// exercise: first the explanation, then do it yourself.
import Base from '../../../layouts/TrainingLayout.astro';
import Trede from '../../../components/Trede.astro';
import { getExercises } from '../../../exercises';

export function getStaticPaths() {
  return getExercises().map((ex) => ({ params: { slug: ex.slug }, props: { ex } }));
}
const { ex } = Astro.props;
const { Content } = ex;
---
<Base title={ex.title} description={ex.summary}>
  <link rel="stylesheet" href="/assets/chat.css">
  {ex.ladder.length > 0 && (
    <>
      <section class="hero">
        <div class="hero-inner">
          <p class="eyebrow"><a href="/training/oefeningen/">Terug naar de route</a> · Stap {ex.step}</p>
          <h1>{ex.title}</h1>
          <p class="lead">Eerst de uitleg: {ex.ladder.length > 1 ? `trede ${ex.ladder.slice(0, -1).join(', ')} en ${ex.ladder.at(-1)}` : `trede ${ex.ladder[0]}`} van de <a href="/training/oefeningen/contexttrap/">contexttrap</a>, met een zwak en een sterk voorbeeld. Daarna <a href="#zelf-doen">doe je het zelf</a>.</p>
        </div>
      </section>
      {ex.ladder.map((nr, i) => <Trede nr={nr} tinted={i % 2 === 0} />)}
    </>
  )}
  <section class="sectie" id="zelf-doen">
    <div class="wrap oef-met-chat">
      <div class="oef-tekst">
        {ex.ladder.length > 0
          ? <p class="label">Stap {ex.step} · nu zelf doen</p>
          : <><p><a href="/training/oefeningen/">Terug naar de route</a></p><p class="label">Stap {ex.step} · {ex.role}</p></>}
        {/* With the explanation above, the hero already carries the title: hide the h1 of the Markdown. */}
        <article class={`markdown${ex.ladder.length > 0 ? ' markdown--zonder-titel' : ''}`}><Content /></article>
      </div>
      <aside class="oef-chat" aria-label={ex.connection ? 'Chat met Claude, met koppeling' : 'Chat met Claude, zonder koppeling'}>
        <div class="vc" data-vorm="paneel" data-context={ex.slug} data-assistent={ex.connection ? 'koppeling' : 'zonder'}></div>
      </aside>
      {/* External files: no inline scripts (CSP). prompt.js turns the prompt blocks into fill-in fields. */}
      <script is:inline src="/assets/prompt.js" defer></script>
      <script is:inline src="/assets/chat.js" defer></script>
    </div>
  </section>
</Base>
