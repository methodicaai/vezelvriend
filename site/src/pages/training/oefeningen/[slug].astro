---
import Base from '../../../layouts/TrainingLayout.astro';
import { getExercises } from '../../../exercises';

export function getStaticPaths() {
  return getExercises().map((ex) => ({ params: { slug: ex.slug }, props: { ex } }));
}
const { ex } = Astro.props;
const { Content } = ex;
---
<Base title={ex.title} description={ex.summary}>
  <section class="sectie">
    <div class="wrap smal">
      <p><a href="/training/oefeningen/">Alle oefeningen</a></p>
      <p class="label">Oefening {ex.number} · {ex.role}</p>
      <article class="markdown"><Content /></article>
      {/* Turns the prompt blocks into fill-in fields with a copy button. External file: no inline scripts (CSP). */}
      <script is:inline src="/assets/prompt.js" defer></script>
    </div>
  </section>
</Base>
