---
// Step 2: a short overview of the context ladder, as an introduction. Each step
// of the ladder is explained right above the exercise that practises it
// (data and component: src/contexttrap.ts, components/Trede.astro).
import Base from '../../../layouts/TrainingLayout.astro';
import { steps, explainedAt } from '../../../contexttrap';
---
<Base title="De contexttrap" description="Kort overzicht: vijf manieren waarop context bij een AI komt.">
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Stap 2 · kort overzicht · ± 5 minuten</p>
      <h1>De contexttrap</h1>
      <p class="lead">Goede context erin, kritisch nakijken eruit. Er zijn vijf manieren waarop context bij een AI komt: de vijf treden van de contexttrap. Hieronder zie je ze in één oogopslag. Elke trede leer je later kennen, vlak voor de oefening waarin je hem zelf doet.</p>
    </div>
  </section>

  <section class="sectie">
    <div class="wrap">
      <div class="tabel-vak">
        <table class="tabel">
          <thead><tr><th>Trede</th><th>Wie kiest de context?</th><th>Controlevraag</th><th>Uitleg en oefening</th></tr></thead>
          <tbody>
            {steps.map((s) => (
              <tr><td><strong>{s.nr} {s.name}</strong></td><td>{s.who}</td><td>{s.check}</td><td><a href={explainedAt[s.nr].href}>{explainedAt[s.nr].label}</a></td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="trap-let-op">
        <p><strong>Hoger is niet beter.</strong> De treden zijn afwegingen, geen niveaus. Hoe hoger, hoe minder werk voor jou, maar hoe minder je zelf ziet wat er in de AI gaat. Een organisatie kan bewust op een lage trede blijven staan.</p>
        <p><strong>In de oefeningen zitten bewust fouten.</strong> Fouten maken is de bedoeling: daar leer je het meest van. Na elke oefening bespreek je met de trainer wat je zag, waarom het gebeurde, en wat het betekent voor jouw werk.</p>
      </div>

      <p><a class="knop knop--vol" href="/training/oefeningen/03-context/">Naar stap 3: trede 0 en 1</a></p>
    </div>
  </section>
</Base>
