---
// Step 5: the context ladder. The only place where the ladder is shown and
// explained: first the five steps as a staircase, then per step what it is, a
// weak and a strong example (red and green) and the check question. The
// exercises only carry the name of the step they practise (src/route.ts).
// Data: src/contexttrap.ts.
import Base from '../../../layouts/TrainingLayout.astro';
import Vlak from '../../../components/Vlak.astro';
import Volgende from '../../../components/Volgende.astro';
import { steps } from '../../../contexttrap';
import { headLine, route } from '../../../route';

const practisedIn = (nr: number) => route.filter((s) => s.trede?.includes(nr));
const example = (e: { prompt: string; answer: string; note: string }, label: string, tone: 'rood' | 'groen') => ({
  label, tone,
  blocks: [{ label: 'Prompt', pre: e.prompt }, { label: 'Antwoord van de AI (voorbeeld)', quote: e.answer }, { text: e.note }],
});
---
<Base title="De contexttrap" description="Vijf manieren waarop context bij een AI komt, met voorbeelden en controlevragen.">
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">{headLine(5)}</p>
      <h1>De contexttrap</h1>
      <p class="lead">Goede context erin, kritisch nakijken eruit. Er zijn vijf manieren waarop context bij een AI komt: de vijf treden van de contexttrap. Hieronder zie je ze eerst in één oogopslag, en daarna per trede een zwak en een sterk voorbeeld. In de oefeningen kom je ze weer tegen.</p>
    </div>
  </section>

  <section class="sectie">
    <div class="wrap">
      <h2>De vijf treden</h2>
      <ol class="trap-trap">
        {steps.map((s) => (
          <li><a class={`trap-trede trap-h${s.nr}`} href={`#trede-${s.nr}`}>
            <span class="trap-nr">{s.nr}</span>
            <span class="trap-naam">{s.name}</span>
            <span class="trap-wie">Wie kiest de context? {s.who}.</span>
          </a></li>
        ))}
      </ol>
      <p class="trap-pijl"><span>Jij ziet precies wat erin gaat, maar het kost je meer werk</span><span>Minder werk, maar je ziet minder wat erin gaat</span></p>

      <div class="trap-let-op">
        <p><strong>Hoger is niet beter.</strong> De treden zijn afwegingen, geen niveaus. Hoe hoger, hoe minder werk voor jou, maar hoe minder je zelf ziet wat er in de AI gaat. Een organisatie kan bewust op een lage trede blijven staan.</p>
        <p><strong>In de oefeningen zitten bewust fouten.</strong> Fouten maken is de bedoeling: daar leer je het meest van. Na elke oefening bespreek je met de trainer wat je zag, waarom het gebeurde, en wat het betekent voor jouw werk.</p>
      </div>
    </div>
  </section>

  {steps.map((s, i) => (
    <section class={`sectie trap-sectie${i % 2 === 0 ? ' sectie--vlak' : ''}`} id={`trede-${s.nr}`}>
      <div class="wrap">
        <p class="label">Trede {s.nr} · {s.who}</p>
        <h2>{s.name}</h2>
        <p class="prose">{s.intro} <em>Bijvoorbeeld: {s.copilot}.</em></p>
        {s.rule && <p class="trap-regel prose"><strong>Vuistregel:</strong> {s.rule}</p>}

        <Vlak columns={2} items={[example(s.weak, 'Zwak', 'rood'), example(s.strong, 'Sterk', 'groen')]} />

        <div class="trap-controle">
          <p class="trap-kop">Controlevraag: {s.check}</p>
          <ul>{s.checkHow.map((c) => <li>{c}</li>)}</ul>
          <p class="trap-risico"><strong>Nieuw risico op deze trede:</strong> {s.risk}</p>
        </div>
        {practisedIn(s.nr).length > 0 && (
          <p class="trap-oefen">Je oefent dit in {practisedIn(s.nr).map((p, j) => <>{j > 0 && ' en '}<a href={p.href}>stap {p.nr}: {p.title}</a></>)}.</p>
        )}
        {i === steps.length - 1 && <Volgende nr={5} />}
      </div>
    </section>
  ))}
</Base>
