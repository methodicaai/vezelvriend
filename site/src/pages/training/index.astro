---
// Start page of the training. Everything else is reached from here: the route
// (which begins with the company, the website and the systems) and, in the
// footer of every page, the code, Methodica and the company website.
import Base from '../../layouts/TrainingLayout.astro';
import Vlak from '../../components/Vlak.astro';
import { route } from '../../route';
---
<Base title="Start">
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">AI op je werk, met verdieping voor analisten en testers</p>
      <h1>AI is zo goed als de <em>context</em> die je meegeeft.</h1>
      <p class="lead">Dit is de oefenomgeving van Methodica. Je maakt eerst kennis met het (verzonnen) glasvezelbedrijf Vezelvriend: het bedrijf, de website en de systemen. Daarna ontdek je waarvoor jij AI kunt gebruiken, en oefen je bij Vezelvriend hoe je AI goed inzet: context meegeven, grenzen stellen en valkuilen in data herkennen. Je sluit af met een echte taak uit je eigen werk.</p>
    </div>
  </section>

  <section class="sectie">
    <div class="wrap">
      <h2>Wat je hier leert</h2>
      <Vlak columns={3} items={[
        { label: 'Context', title: 'Geef de AI wat jij ziet', text: 'Een AI weet niets van jouw klant, jouw systemen of het tijdstip. Je oefent met wat je wel en niet meegeeft, en ziet wat dat doet met het antwoord.' },
        { label: 'Guardrails', title: 'Spreek af wat niet mag', text: 'Je schrijft regels voor wat de AI wel en niet mag adviseren, zodat een goed klinkend antwoord geen verkeerde beslissing wordt.' },
        { label: 'Valkuilen', title: 'Vertrouw de data niet blind', text: 'Ook in nepdata zitten de fouten van echte systemen. Je leert ze herkennen voordat je ze aan een AI voert.' },
      ]} />
    </div>
  </section>

  <section class="sectie">
    <div class="wrap smal">
      <div class="kern">
        <p class="label">De kernboodschap</p>
        <p>Een AI-antwoord is nooit beter dan de context die je meegeeft.</p>
      </div>
      <div class="knoppen">
        <a class="knop knop--vol" href="/training/oefeningen/">Naar de route</a>
        <a class="knop knop--rand" href={route[0].href}>Begin bij stap 1</a>
      </div>
    </div>
  </section>
</Base>
