---
import Base from '../../layouts/Base.astro';
import { getExercises } from '../../exercises';

export function getStaticPaths() {
  return getExercises().map((ex) => ({ params: { slug: ex.slug }, props: { ex } }));
}
const { ex } = Astro.props;
const { Content } = ex;
---
<Base title={ex.title} description={ex.summary}>
  <section class="sectie">
    <div class="wrap smal">
      <p><a href="/oefeningen/">Alle oefeningen</a></p>
      <p class="label">Oefening {ex.number} · {ex.role}</p>
      <article class="markdown"><Content /></article>
    </div>
  </section>
</Base>
