---
import Layout from '../layouts/CompanyLayout.astro';
import { world, getPlans, euro } from '../world';
const plans = getPlans().filter((p) => !p.business);
const cheapest = Math.min(...plans.map((p) => p.fee));
---
<Layout title="Glasvezel van je buren">
  <section class="vv-hero">
    <div class="wrap">
      <h1>Snel glasvezel van je buren in {world.city}.</h1>
      <p>Vezelvriend is het glasvezelbedrijf uit {world.city} {world.district}. Echt glasvezel tot in je meterkast, een klantenservice om de hoek en abonnementen zonder kleine lettertjes. Vanaf {euro(cheapest)} per maand.</p>
      <div class="vv-knoppen">
        <a class="vv-knop vv-knop--accent" href="/internet/">Bekijk abonnementen</a>
        <a class="vv-knop vv-knop--rand" href="/storingen/">Storing? Bekijk de status</a>
      </div>
    </div>
  </section>

  <section class="vv-sectie">
    <div class="wrap">
      <h2>Waarom Vezelvriend?</h2>
      <div class="vv-kaarten">
        <div class="vv-kaart">
          <span class="vv-icoon" aria-hidden="true">⚡</span>
          <h3>Echt glasvezel</h3>
          <p>Glasvezel tot in je meterkast, met de Vezelbox als modem. Even snel uploaden als downloaden.</p>
        </div>
        <div class="vv-kaart">
          <span class="vv-icoon" aria-hidden="true">🏘️</span>
          <h3>Lokaal</h3>
          <p>Ons team van zo'n 25 mensen zit in {world.city}. Onze monteurs kennen de wijk.</p>
        </div>
        <div class="vv-kaart">
          <span class="vv-icoon" aria-hidden="true">📞</span>
          <h3>Klantenservice die meedenkt</h3>
          <p>Ook op zaterdag. We kijken eerst samen wat er aan de hand is, en sturen pas een monteur als dat echt nodig is.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="vv-sectie vv-sectie--zacht">
    <div class="wrap">
      <h2>Internet zonder gedoe</h2>
      <div class="vv-kaarten">
        {plans.map((p) => (
          <div class="vv-pakket">
            <h3>{p.product}</h3>
            <p class="vv-snelheid">{p.download} <small>Mbit/s</small></p>
            <p class="vv-prijs">{euro(p.fee)} <small>per maand</small></p>
            <a class="vv-knop vv-knop--vol" href="/internet/">Meer informatie</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="vv-sectie">
    <div class="wrap">
      <div class="vv-training">
        <h2>Ben je hier voor de training?</h2>
        <p>Vezelvriend is een oefenbedrijf. Deze website, de klanten en de systemen zijn nagebouwd voor de AI-training van Methodica voor businessanalisten en testers.</p>
        <div class="vv-knoppen">
          <a class="vv-knop vv-knop--accent" href="/training/">Naar de training en de opdrachten</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
