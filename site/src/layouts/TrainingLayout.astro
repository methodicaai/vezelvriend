---
// Page frame of the training part (/training/), in the methodica.nl style.
// The company website of Vezelvriend uses CompanyLayout.astro instead, so
// participants always see whether they are "at the company" or "in the training".
// The notice sits on every page on purpose: participants (and anyone who
// lands here via a search engine) must never mistake Vezelvriend for a real ISP.
import world from '../../../config/world.json';

interface Props { title: string; description?: string; }
const { title, description = 'Oefenomgeving van Methodica: leer AI goed inzetten met context, guardrails en oog voor valkuilen in data.' } = Astro.props;

// No menu at the top: everything starts at Start and follows the route. The
// other pages are linked in the footer of every page.
const footerLinks = [
  { href: '/training/', label: 'Start' },
  { href: '/training/oefeningen/', label: 'De route' },
  { href: '/training/oefeningen/code/', label: 'Code' },
  { href: '/training/over-methodica/', label: 'Over Methodica' },
  { href: '/', label: 'Naar vezelvriend.nl' },
];
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title} | Training | Vezelvriend oefenomgeving</title>
  <meta name="description" content={description}>
  {/* Keep search engines out: a fictional ISP on a real domain must not show up
      for people searching for a real internet outage. */}
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/fonts.css">
  <link rel="stylesheet" href="/assets/theme.css">
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
  <a class="skip" href="#inhoud">Naar de inhoud</a>
  <div class="fictief" role="note">
    <p>{world.company} is een <strong>fictief bedrijf</strong>, bedacht voor de AI-training van Methodica. Het is geen echte internetaanbieder. Alle klanten, namen en nummers zijn verzonnen.</p>
  </div>
  <header class="site-header">
    <div class="bar">
      <a class="brand" href="/training/">
        <img src="/favicon.svg" alt="" width="28" height="28">
        <span><span class="brand-name">Vezelvriend</span><br><span class="brand-sub">oefenomgeving van Methodica</span></span>
      </a>
    </div>
  </header>
  <main id="inhoud">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <nav class="voet-links" aria-label="Meer">
        {footerLinks.map((l) => <a href={l.href} aria-current={Astro.url.pathname === l.href ? 'page' : undefined}>{l.label}</a>)}
      </nav>
      <p class="voet-naam">Methodica</p>
      <p>AI is zo goed als de context die je meegeeft.</p>
      <p>{world.company} ({world.city} {world.district}) is fictief. Code: MIT-licentie. Oefeningen en teksten: CC BY-NC 4.0. <a href="https://github.com/methodicaai/vezelvriend">Bekijk de broncode</a>.</p>
      <p>Deze site gebruikt geen cookies en geen tracking.</p>
    </div>
  </footer>
  {/* Systems and documents open in a new tab; .txt and .csv links download. */}
  <script is:inline src="/assets/links.js" defer></script>
</body>
</html>
