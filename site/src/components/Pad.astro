---
// Winding path in the methodica.nl style (section type "pad" on methodica.nl/trainingen/):
// numbered stepping stones on a dotted trail through the middle, cards alternating
// left and right. On narrow screens the trail moves to the left edge.
// Styling: .pad-* in public/assets/site.css. /assets/pad.js lights the trail up on
// scroll and handles the length switch (only the core steps, or all steps); it
// re-alternates the sides when steps are hidden, so both curves are rendered.
interface Link { href: string; label: string; }
// nr: the step number on the stone, the same as on the step's own page.
// core: part of the short route; shown as a small badge.
// A step has one link (href + linkLabel) or several (links), like "Naar behoefte" on methodica.nl.
interface Step { nr: string; label?: string; title: string; text?: string; href?: string; linkLabel?: string; links?: Link[]; core?: boolean; }
interface Props { steps: Step[]; }
const { steps } = Astro.props;
const linksOf = (step: Step): Link[] => step.links ?? (step.href ? [{ href: step.href, label: step.linkLabel ?? 'Lees verder' }] : []);
// Which way the trail bends depends on the side of the card.
const CURVE_LEFT = 'M50 0 C50 18 82 26 82 50 S50 82 50 100';
const CURVE_RIGHT = 'M50 0 C50 18 18 26 18 50 S50 82 50 100';
---
<ol class="pad-lijst">
  {steps.map((step, i) => (
    <li class={`pad-stap${i % 2 === 1 ? ' pad-stap--rechts' : ''}`} data-kern={step.core ? 'ja' : undefined}>
      <div class="pad-spoor" aria-hidden="true">
        <span class="pad-steen">{step.nr}</span>
        <span class="spoor-basis"><svg viewBox="0 0 100 100" preserveAspectRatio="none"><path class="krul-l" d={CURVE_LEFT} /><path class="krul-r" d={CURVE_RIGHT} /></svg></span>
        <span class="spoor-licht"><svg viewBox="0 0 100 100" preserveAspectRatio="none"><path class="krul-l" d={CURVE_LEFT} /><path class="krul-r" d={CURVE_RIGHT} /></svg></span>
      </div>
      <div class="pad-kaart">
        <p class="label">Stap {step.nr}{step.label && ` · ${step.label}`}{step.core && <span class="pad-kern">kern</span>}</p>
        <h3>{step.title}</h3>
        {step.text && <p>{step.text}</p>}
        {linksOf(step).length > 0 && (
          <p class="links">
            {linksOf(step).map((l) => (
              <a href={l.href}>{l.label}<span aria-hidden="true"> →</span></a>
            ))}
          </p>
        )}
      </div>
    </li>
  ))}
</ol>
