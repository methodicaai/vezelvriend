---
// One step of the context ladder: what it is, a weak and a strong example, and
// the check question. Shown right above the exercise that practises it.
import { steps } from '../contexttrap';

interface Props { nr: number; tinted?: boolean }
const { nr, tinted = false } = Astro.props;
const s = steps.find((x) => x.nr === nr)!;
---
<section class={`sectie${tinted ? ' sectie--vlak' : ''}`} id={`trede-${s.nr}`}>
  <div class="wrap">
    <p class="label">Uitleg · trede {s.nr} van de <a href="/training/oefeningen/contexttrap/">contexttrap</a> · {s.who}</p>
    <h2>{s.name}</h2>
    <p class="prose">{s.intro} <em>Bijvoorbeeld: {s.copilot}.</em></p>

    <div class="trap-vergelijk">
      <div class="trap-voorbeeld trap-voorbeeld--zwak">
        <p class="trap-kop">Zwak</p>
        <pre class="trap-prompt">{s.weak.prompt}</pre>
        <p class="trap-sub">Antwoord van de AI (voorbeeld)</p>
        <p class="trap-antwoord">{s.weak.answer}</p>
        <p class="trap-noot">{s.weak.note}</p>
      </div>
      <div class="trap-voorbeeld trap-voorbeeld--sterk">
        <p class="trap-kop">Sterk</p>
        <pre class="trap-prompt">{s.strong.prompt}</pre>
        <p class="trap-sub">Antwoord van de AI (voorbeeld)</p>
        <p class="trap-antwoord">{s.strong.answer}</p>
        <p class="trap-noot">{s.strong.note}</p>
      </div>
    </div>

    <div class="trap-controle">
      <p class="trap-kop">Controlevraag: {s.check}</p>
      <ul>{s.checkHow.map((c) => <li>{c}</li>)}</ul>
      <p class="trap-risico"><strong>Nieuw risico op deze trede:</strong> {s.risk}</p>
    </div>
  </div>
</section>
