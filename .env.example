# Copy to .env on the server and fill in. .env is in .gitignore: never commit it.
# Without ANTHROPIC_API_KEY the AI box stays off and only "Kopieer prompt" is shown.

# API key from console.anthropic.com (workspace "Vezelvriend")
ANTHROPIC_API_KEY=

# Password for the trainer screen at /trainer/
TRAINER_PASSWORD=

# Random string that signs login cookies, e.g. output of: openssl rand -hex 32
SESSION_SECRET=

# Optional settings (defaults shown)
AI_CHAT_MODEL=claude-sonnet-5-5
AI_CHAT_EFFORT=medium
AI_MAX_TOKENS=8000
AI_MAX_PER_DAY=40
AI_MAX_PROMPT_CHARS=30000

# Test mode without a key: answers are fake, the rest works. Never on in production.
AI_FAKE=0
