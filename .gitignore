# Trainer material: answers, pitfall register, expected outcomes.
# NEVER commit this folder. It moves to the private repo methodicaai/vezelvriend-trainer.
trainer-private/

# Generated: the SQLite database is rebuilt from data/ on every start,
# so the JSON seed files stay the single, readable source of truth.
*.db
*.db-journal
*.db-wal
*.db-shm

# Secrets never belong in this repo.
.env
.env.*
*.pem
*.key

node_modules/
site/dist/
site/.astro/
# Copied from node_modules at build time (site/scripts/copy-vendor.mjs)
site/public/vendor/
.DS_Store
Thumbs.db

# Local editor/agent settings
.claude/

# Server-specific Docker settings (see docs/server.md)
docker-compose.override.yml
!.env.example

# Generated world (real BAG addresses + 2000 fake customers): stays on the server,
# never in the public repo. Built by tools/world/.
data/generated/

# Trainer-only files on the server (answers of "vind de fout"), mounted into the ai container.
private/
